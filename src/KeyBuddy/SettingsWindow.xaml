<Window x:Class="KeyBuddy.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="KeyBuddy — Customization &amp; Settings"
        Height="600" Width="550"
        MinHeight="500" MinWidth="480"
        WindowStartupLocation="CenterScreen"
        Background="#18181E"
        Foreground="#ECEFF1"
        Icon="app.ico">

    <Window.Resources>
        <!-- Dark tab item style -->
        <Style TargetType="TabItem">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabItem">
                        <Border x:Name="TabBorder"
                                Background="#20222B"
                                BorderBrush="#353744"
                                BorderThickness="1,1,1,0"
                                CornerRadius="6,6,0,0"
                                Padding="14,8"
                                Margin="0,0,4,0">
                            <ContentPresenter x:Name="TabContent"
                                              ContentSource="Header"
                                              RecognizesAccessKey="True"
                                              VerticalAlignment="Center"
                                              HorizontalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="TabBorder" Property="Background" Value="#2D303E" />
                                <Setter TargetName="TabBorder" Property="BorderBrush" Value="#64B5F6" />
                                <Setter TargetName="TabBorder" Property="BorderThickness" Value="1,2,1,0" />
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="TabBorder" Property="Background" Value="#262835" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Standard Button Style -->
        <Style x:Key="DialogButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#2F3242" />
            <Setter Property="Foreground" Value="#ECEFF1" />
            <Setter Property="BorderBrush" Value="#4B4E63" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="12,6" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="5" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#3D4155" />
                                <Setter TargetName="bd" Property="BorderBrush" Value="#64B5F6" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#252733" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="PrimaryButtonStyle" TargetType="Button" BasedOn="{StaticResource DialogButtonStyle}">
            <Setter Property="Background" Value="#2E7D32" />
            <Setter Property="Foreground" Value="#FFFFFF" />
            <Setter Property="BorderBrush" Value="#4CAF50" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>
    </Window.Resources>

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <!-- Header -->
            <RowDefinition Height="Auto" />
            <!-- Tab Control -->
            <RowDefinition Height="*" />
            <!-- Footer Action Buttons -->
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- HEADER -->
        <DockPanel Grid.Row="0" Margin="0,0,0,14">
            <TextBlock Text="⌨️" FontSize="24" VerticalAlignment="Center" Margin="0,0,10,0" />
            <StackPanel VerticalAlignment="Center">
                <TextBlock Text="KeyBuddy Customization" FontSize="18" FontWeight="Bold" Foreground="#64B5F6" />
                <TextBlock Text="Configure rescue keys, hold-to-replace shortcuts, and layout settings"
                           FontSize="12" Foreground="#9E9E9E" />
            </StackPanel>
        </DockPanel>

        <!-- TABS -->
        <TabControl Grid.Row="1" Background="#22242E" BorderBrush="#353744" BorderThickness="1">

            <!-- TAB 1: RESCUE BAR KEYS -->
            <TabItem Header="🎯 Rescue Bar Keys">
                <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="14">
                    <StackPanel>
                        <TextBlock Text="Quick Rescue Bar Keys" FontSize="14" FontWeight="Bold" Foreground="#ECEFF1" Margin="0,0,0,4" />
                        <TextBlock Text="These keys appear on your compact floating bar on screen. Perfect for any physical keys that are broken or failing."
                                   FontSize="11" Foreground="#B0BEC5" TextWrapping="Wrap" Margin="0,0,0,12" />

                        <!-- Current Keys Badge List -->
                        <Border Background="#1A1C24" BorderBrush="#353744" BorderThickness="1" CornerRadius="6" Padding="12" Margin="0,0,0,12">
                            <StackPanel>
                                <TextBlock Text="Active Keys on Floating Bar:" FontSize="12" FontWeight="SemiBold" Foreground="#64B5F6" Margin="0,0,0,8" />
                                <WrapPanel x:Name="QuickKeysWrapPanel" Orientation="Horizontal" Margin="0,4" />
                                <TextBlock x:Name="EmptyKeysWarning" Text="⚠️ No keys selected! Add at least one key below."
                                           Foreground="#FFB74D" FontSize="11" FontStyle="Italic" Visibility="Collapsed" Margin="0,4" />
                            </StackPanel>
                        </Border>

                        <!-- Add Key Section -->
                        <Border Background="#1A1C24" BorderBrush="#353744" BorderThickness="1" CornerRadius="6" Padding="12" Margin="0,0,0,12">
                            <StackPanel>
                                <TextBlock Text="Add a Key to Rescue Bar" FontSize="12" FontWeight="SemiBold" Foreground="#81C784" Margin="0,0,0,8" />
                                <Grid Margin="0,0,0,8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>

                                    <!-- Key input -->
                                    <TextBlock Text="Key Name / Character:" VerticalAlignment="Center" Margin="0,0,8,0" FontSize="12" Foreground="#CFD8DC" />
                                    <TextBox Grid.Column="1" x:Name="NewKeyInput" Height="28" VerticalContentAlignment="Center"
                                             Background="#2A2C38" Foreground="White" BorderBrush="#45485E" Padding="6,2"
                                             ToolTip="Type any key or symbol, e.g. 'P', '4', 'E', 'Enter', 'Backspace', 'Space', 'Delete', 'Tab'" />

                                    <Button Grid.Column="2" Style="{StaticResource PrimaryButtonStyle}" Content="➕ Add Key"
                                            Click="OnAddKeyClick" Margin="8,0,0,0" Height="28" Padding="12,2" />
                                </Grid>

                                <!-- Quick Preset Key Pills -->
                                <TextBlock Text="Or quickly pick from common keys:" FontSize="11" Foreground="#90A4AE" Margin="0,4,0,4" />
                                <WrapPanel Margin="0,2">
                                    <Button Style="{StaticResource DialogButtonStyle}" Content="Backspace" Click="OnPresetKeyClick" Margin="0,0,6,6" Padding="8,4" />
                                    <Button Style="{StaticResource DialogButtonStyle}" Content="Enter" Click="OnPresetKeyClick" Margin="0,0,6,6" Padding="8,4" />
                                    <Button Style="{StaticResource DialogButtonStyle}" Content="Space" Click="OnPresetKeyClick" Margin="0,0,6,6" Padding="8,4" />
                                    <Button Style="{StaticResource DialogButtonStyle}" Content="Tab" Click="OnPresetKeyClick" Margin="0,0,6,6" Padding="8,4" />
                                    <Button Style="{StaticResource DialogButtonStyle}" Content="Delete" Click="OnPresetKeyClick" Margin="0,0,6,6" Padding="8,4" />
                                    <Button Style="{StaticResource DialogButtonStyle}" Content="Esc" Click="OnPresetKeyClick" Margin="0,0,6,6" Padding="8,4" />
                                    <Button Style="{StaticResource DialogButtonStyle}" Content="P" Click="OnPresetKeyClick" Margin="0,0,6,6" Padding="8,4" />
                                    <Button Style="{StaticResource DialogButtonStyle}" Content="4" Click="OnPresetKeyClick" Margin="0,0,6,6" Padding="8,4" />
                                    <Button Style="{StaticResource DialogButtonStyle}" Content="@" Click="OnPresetKeyClick" Margin="0,0,6,6" Padding="8,4" />
                                </WrapPanel>
                            </StackPanel>
                        </Border>

                        <!-- Reset Button -->
                        <Button Style="{StaticResource DialogButtonStyle}" Content="↺ Reset to Defaults (P, 4, Backspace)"
                                Click="OnResetKeysClick" HorizontalAlignment="Left" Padding="10,4" Margin="0,4,0,0" />
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- TAB 2: PHYSICAL KEY SHORTCUTS -->
            <TabItem Header="⚡ Hold-to-Replace Rules">
                <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="14">
                    <StackPanel>
                        <TextBlock Text="Physical Key Hold Shortcuts" FontSize="14" FontWeight="Bold" Foreground="#ECEFF1" Margin="0,0,0,4" />
                        <TextBlock Text="Hold down any working key on your physical keyboard to automatically type a broken key. For example, hold 'O' for 350ms to type 'P'."
                                   FontSize="11" Foreground="#B0BEC5" TextWrapping="Wrap" Margin="0,0,0,12" />

                        <!-- List of Rules -->
                        <Border Background="#1A1C24" BorderBrush="#353744" BorderThickness="1" CornerRadius="6" Padding="12" Margin="0,0,0,12">
                            <StackPanel>
                                <TextBlock Text="Active Hold Shortcuts:" FontSize="12" FontWeight="SemiBold" Foreground="#64B5F6" Margin="0,0,0,8" />
                                <StackPanel x:Name="RulesListContainer" Margin="0,4" />
                                <TextBlock x:Name="EmptyRulesNotice" Text="No shortcuts configured yet."
                                           Foreground="#78909C" FontSize="11" FontStyle="Italic" Visibility="Collapsed" Margin="0,4" />
                            </StackPanel>
                        </Border>

                        <!-- Add Rule Box -->
                        <Border Background="#1A1C24" BorderBrush="#353744" BorderThickness="1" CornerRadius="6" Padding="12" Margin="0,0,0,12">
                            <StackPanel>
                                <TextBlock Text="Create New Hold Shortcut" FontSize="12" FontWeight="SemiBold" Foreground="#81C784" Margin="0,0,0,8" />
                                <Grid Margin="0,4">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>

                                    <!-- Trigger -->
                                    <StackPanel Grid.Column="0">
                                        <TextBlock Text="Physical Key to Hold:" FontSize="11" Foreground="#CFD8DC" Margin="0,0,0,3" />
                                        <TextBox x:Name="RuleTriggerInput" Height="28" VerticalContentAlignment="Center"
                                                 Background="#2A2C38" Foreground="White" BorderBrush="#45485E" Padding="6,2"
                                                 ToolTip="Single key on your keyboard, e.g. 'O', '2', 'A', 'E'" />
                                    </StackPanel>

                                    <TextBlock Grid.Column="1" Text="➔" FontSize="16" Foreground="#64B5F6"
                                               VerticalAlignment="Center" Margin="12,14,12,0" />

                                    <!-- Output -->
                                    <StackPanel Grid.Column="2">
                                        <TextBlock Text="Replacement to Type:" FontSize="11" Foreground="#CFD8DC" Margin="0,0,0,3" />
                                        <TextBox x:Name="RuleOutputInput" Height="28" VerticalContentAlignment="Center"
                                                 Background="#2A2C38" Foreground="White" BorderBrush="#45485E" Padding="6,2"
                                                 ToolTip="Character or symbol to type, e.g. 'P', '4', '@', '$'" />
                                    </StackPanel>

                                    <Button Grid.Column="3" Style="{StaticResource PrimaryButtonStyle}" Content="➕ Add Rule"
                                            Click="OnAddRuleClick" Margin="12,18,0,0" Height="28" Padding="12,2" VerticalAlignment="Center" />
                                </Grid>
                            </StackPanel>
                        </Border>

                        <!-- Hold Delay Slider -->
                        <Border Background="#1A1C24" BorderBrush="#353744" BorderThickness="1" CornerRadius="6" Padding="12">
                            <StackPanel>
                                <DockPanel Margin="0,0,0,6">
                                    <TextBlock Text="Hold Delay Threshold:" FontSize="12" FontWeight="SemiBold" Foreground="#CFD8DC" />
                                    <TextBlock x:Name="ThresholdDisplay" Text="350 ms" FontSize="12" FontWeight="Bold" Foreground="#64B5F6" HorizontalAlignment="Right" />
                                </DockPanel>
                                <Slider x:Name="ThresholdSlider" Minimum="200" Maximum="800" Value="350"
                                        TickFrequency="25" IsSnapToTickEnabled="True"
                                        ValueChanged="OnThresholdSliderValueChanged" />
                                <TextBlock Text="How long you must hold the key before the replacement triggers (Default: 350 ms)."
                                           FontSize="10" Foreground="#78909C" Margin="0,4,0,0" />
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- TAB 3: GENERAL SETTINGS -->
            <TabItem Header="⚙️ General Options">
                <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="14">
                    <StackPanel>
                        <TextBlock Text="General &amp; Layout Options" FontSize="14" FontWeight="Bold" Foreground="#ECEFF1" Margin="0,0,0,12" />

                        <!-- Keyboard Display Mode -->
                        <Border Background="#1A1C24" BorderBrush="#353744" BorderThickness="1" CornerRadius="6" Padding="12" Margin="0,0,0,12">
                            <StackPanel>
                                <TextBlock Text="Keyboard Display Mode:" FontSize="12" FontWeight="SemiBold" Foreground="#64B5F6" Margin="0,0,0,8" />
                                <RadioButton x:Name="RadioRescueBar" Content="Compact Rescue Bar (Floating mini-bar with your custom keys)"
                                             GroupName="LayoutMode" Foreground="White" Margin="0,4" IsChecked="True" />
                                <RadioButton x:Name="RadioFullKeyboard" Content="Full On-Screen Keyboard (Standard QWERTY layout with navigation &amp; tools)"
                                             GroupName="LayoutMode" Foreground="White" Margin="0,4" />
                            </StackPanel>
                        </Border>

                        <!-- Startup & Topmost -->
                        <Border Background="#1A1C24" BorderBrush="#353744" BorderThickness="1" CornerRadius="6" Padding="12" Margin="0,0,0,12">
                            <StackPanel>
                                <CheckBox x:Name="CheckAlwaysOnTop" Content="Always On Top (Keep keyboard visible over all windows)"
                                          Foreground="White" Margin="0,6" IsChecked="True" />
                                <CheckBox x:Name="CheckStartup" Content="Launch automatically on Windows Startup"
                                          Foreground="White" Margin="0,6" IsChecked="True" />
                            </StackPanel>
                        </Border>

                        <!-- Window Opacity -->
                        <Border Background="#1A1C24" BorderBrush="#353744" BorderThickness="1" CornerRadius="6" Padding="12">
                            <StackPanel>
                                <DockPanel Margin="0,0,0,6">
                                    <TextBlock Text="Window Opacity:" FontSize="12" FontWeight="SemiBold" Foreground="#CFD8DC" />
                                    <TextBlock x:Name="OpacityDisplay" Text="100%" FontSize="12" FontWeight="Bold" Foreground="#64B5F6" HorizontalAlignment="Right" />
                                </DockPanel>
                                <Slider x:Name="OpacitySlider" Minimum="0.3" Maximum="1.0" Value="1.0"
                                        TickFrequency="0.05" IsSnapToTickEnabled="True"
                                        ValueChanged="OnOpacitySliderValueChanged" />
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>
        </TabControl>

        <!-- FOOTER BUTTONS -->
        <DockPanel Grid.Row="2" Margin="0,14,0,0">
            <TextBlock Text="Changes apply immediately" FontSize="11" Foreground="#78909C" VerticalAlignment="Center" />
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Style="{StaticResource DialogButtonStyle}" Content="Cancel" Click="OnCancelClick" Margin="0,0,8,0" Width="90" />
                <Button Style="{StaticResource PrimaryButtonStyle}" Content="Save &amp; Apply" Click="OnSaveApplyClick" Width="120" />
            </StackPanel>
        </DockPanel>
    </Grid>
</Window>
