<Window x:Class="KeyBuddy.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:conv="clr-namespace:KeyBuddy.Converters"
        xmlns:models="clr-namespace:KeyBuddy.Models"
        mc:Ignorable="d"
        Title="KeyBuddy — On-Screen Keyboard"
        Height="{Binding Settings.WindowHeight, Mode=TwoWay}"
        Width="{Binding Settings.WindowWidth, Mode=TwoWay}"
        Top="{Binding Settings.WindowTop, Mode=TwoWay}"
        Left="{Binding Settings.WindowLeft, Mode=TwoWay}"
        Opacity="{Binding Settings.WindowOpacity}"
        Topmost="{Binding Settings.AlwaysOnTop}"
        WindowStyle="None"
        AllowsTransparency="False"
        Background="{StaticResource WindowBgBrush}"
        Focusable="False"
        ShowInTaskbar="True"
        Icon="app.ico"
        ResizeMode="NoResize"
        MinHeight="65"
        MinWidth="180">

    <Window.Resources>
        <conv:BoolToVisibilityConverter x:Key="BoolToVis" />
        <conv:BoolToVisibilityConverter x:Key="InvertBoolToVis" Invert="True" />
        <conv:KeyDisplayConverter x:Key="KeyDisplayConv" />
        <conv:KeyActiveConverter x:Key="KeyActiveConv" />

        <!-- Template for rendering a single key button with dynamic sizing and active states -->
        <DataTemplate x:Key="KeyButtonTemplate" DataType="{x:Type models:KeyModel}">
            <Button Command="{Binding DataContext.KeyClickCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                    CommandParameter="{Binding}"
                    PreviewMouseDown="OnKeyButtonPreviewMouseDown"
                    PreviewMouseUp="OnKeyButtonPreviewMouseUp"
                    ToolTip="{Binding ToolTip}"
                    Focusable="False">
                <Button.Style>
                    <Style TargetType="Button" BasedOn="{StaticResource VirtualKeyButtonStyle}">
                        <Style.Triggers>
                            <DataTrigger Value="True">
                                <DataTrigger.Binding>
                                    <MultiBinding Converter="{StaticResource KeyActiveConv}">
                                        <Binding />
                                        <Binding Path="DataContext.Modifiers" RelativeSource="{RelativeSource AncestorType=Window}" />
                                    </MultiBinding>
                                </DataTrigger.Binding>
                                <Setter Property="Background" Value="{StaticResource KeyActiveBrush}" />
                                <Setter Property="Foreground" Value="White" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Button.Style>
                <Grid Margin="4,2">
                    <!-- Dual label for keys with secondary symbols (e.g. 1 / !) -->
                    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                        <TextBlock FontSize="10"
                                   Foreground="{StaticResource TextSecondaryBrush}"
                                   HorizontalAlignment="Center"
                                   Visibility="{Binding DisplaySecondary, Converter={StaticResource BoolToVis}}">
                            <TextBlock.Text>
                                <MultiBinding Converter="{StaticResource KeyDisplayConv}">
                                    <Binding />
                                    <Binding Path="DataContext.Modifiers.Shift" RelativeSource="{RelativeSource AncestorType=Window}" />
                                    <Binding Path="DataContext.Modifiers.CapsLock" RelativeSource="{RelativeSource AncestorType=Window}" />
                                </MultiBinding>
                            </TextBlock.Text>
                        </TextBlock>
                        <TextBlock HorizontalAlignment="Center"
                                   FontWeight="SemiBold"
                                   FontSize="{Binding DataContext.Settings.LargeKeyMode, RelativeSource={RelativeSource AncestorType=Window}, ConverterParameter=Font}">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="FontSize" Value="14" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding DataContext.Settings.LargeKeyMode, RelativeSource={RelativeSource AncestorType=Window}}" Value="True">
                                            <Setter Property="FontSize" Value="17" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                            <TextBlock.Text>
                                <MultiBinding Converter="{StaticResource KeyDisplayConv}">
                                    <Binding />
                                    <Binding Path="DataContext.Modifiers.Shift" RelativeSource="{RelativeSource AncestorType=Window}" />
                                    <Binding Path="DataContext.Modifiers.CapsLock" RelativeSource="{RelativeSource AncestorType=Window}" />
                                </MultiBinding>
                            </TextBlock.Text>
                        </TextBlock>
                    </StackPanel>
                </Grid>
            </Button>
        </DataTemplate>
    </Window.Resources>

    <Border BorderBrush="{StaticResource KeyBorderBrush}" BorderThickness="1">
        <Grid>
            <Grid.RowDefinitions>
                <!-- Title & Window Controls (Collapsed in 3-Key mode to eliminate the large header) -->
                <RowDefinition Height="Auto" />
                <!-- Status & Quick Apps Bar -->
                <RowDefinition Height="Auto" />
                <!-- Keyboard Body -->
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!-- 1. TITLE BAR & WINDOW CONTROLS (Only visible in Full keyboard mode) -->
            <Grid Grid.Row="0" Background="{StaticResource SurfaceBgBrush}" MouseLeftButtonDown="OnTitleBarMouseDown"
                  Visibility="{Binding Settings.MiniTrioOnly, Converter={StaticResource InvertBoolToVis}}" Height="34">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center" Margin="10,0">
                    <TextBlock Text="⌨️" FontSize="14" VerticalAlignment="Center" Margin="0,0,8,0" />
                    <TextBlock Text="KeyBuddy" FontWeight="Bold" FontSize="13" Foreground="{StaticResource TextPrimaryBrush}" VerticalAlignment="Center" />
                    <TextBlock Text="— On-Screen Keyboard" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Center" Margin="6,0,0,0" />
                </StackPanel>

                <!-- Window action buttons: Minimal controls (Settings, Min, Close) -->
                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,6,0">
                    <!-- Switch mode button -->
                    <Button Style="{StaticResource HeaderActionButtonStyle}" Command="{Binding ToggleMiniTrioCommand}" ToolTip="Switch layout" Padding="6,2">
                        <TextBlock Text="{Binding Settings.MiniTrioOnly, ConverterParameter=3Key}">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Text" Value="⌨️ 3-Key" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Settings.MiniTrioOnly}" Value="True">
                                            <Setter Property="Text" Value="⌨️ Full" />
                                            <Setter Property="Foreground" Value="#69F0AE" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </Button>

                    <!-- Always on Top toggle -->
                    <Button Style="{StaticResource HeaderActionButtonStyle}" Click="OnToggleTopmostClick" ToolTip="Toggle Always On Top" Padding="6,2">
                        <TextBlock Text="{Binding Settings.AlwaysOnTop, ConverterParameter=Pin}" FontWeight="Bold">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Text" Value="📌" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Settings.AlwaysOnTop}" Value="True">
                                            <Setter Property="Foreground" Value="{StaticResource AccentBrush}" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </Button>

                    <!-- Settings (only shown if needed, otherwise clean) -->
                    <Button Style="{StaticResource HeaderActionButtonStyle}" Click="OnOpenSettingsWindowClick" ToolTip="Settings &amp; Customization" Padding="6,2">
                        <TextBlock Text="⚙️" />
                    </Button>

                    <Button Style="{StaticResource HeaderActionButtonStyle}" Click="OnMinimizeClick" ToolTip="Minimize" Width="26">
                        <TextBlock Text="—" VerticalAlignment="Center" HorizontalAlignment="Center" />
                    </Button>
                    <Button Style="{StaticResource HeaderActionButtonStyle}" Click="OnCloseClick" ToolTip="Close" Width="26">
                        <TextBlock Text="✕" VerticalAlignment="Center" HorizontalAlignment="Center" Foreground="#FF6B6B" />
                    </Button>
                </StackPanel>
            </Grid>

            <!-- 2. STATUS & TARGET BAR (Hidden in 3-Key Mode to keep it ultra-clean) -->
            <Grid Grid.Row="1" Background="{StaticResource WindowBgBrush}"
                  Visibility="{Binding Settings.MiniTrioOnly, Converter={StaticResource InvertBoolToVis}}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <!-- Target Window Indicator -->
                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center" Margin="10,0">
                    <TextBlock Text="🎯 Target:" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Center" />
                    <Border Background="{StaticResource BadgeBgBrush}" CornerRadius="4" Padding="6,2" Margin="6,0,0,0">
                        <TextBlock Text="{Binding TargetManager.LastTargetTitle}" FontSize="11" Foreground="{StaticResource TextPrimaryBrush}" TextTrimming="CharacterEllipsis" MaxWidth="280" />
                    </Border>
                </StackPanel>

                <!-- Modifier Active Pills -->
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" HorizontalAlignment="Center">
                    <!-- SHIFT pill -->
                    <Border Background="{StaticResource BadgeBgBrush}" CornerRadius="4" Padding="6,2" Margin="3,0">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Modifiers.IsShiftActive}" Value="True">
                                        <Setter Property="Background" Value="{StaticResource KeyActiveBrush}" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <TextBlock Text="{Binding Modifiers.ShiftStatusText}" FontSize="10" FontWeight="Bold" Foreground="White" />
                    </Border>

                    <!-- CAPS pill -->
                    <Border Background="{StaticResource BadgeBgBrush}" CornerRadius="4" Padding="6,2" Margin="3,0">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Modifiers.CapsLock}" Value="True">
                                        <Setter Property="Background" Value="#E0A96D" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <TextBlock Text="{Binding Modifiers.CapsLockStatusText}" FontSize="10" FontWeight="Bold" Foreground="White" />
                    </Border>

                    <!-- CTRL pill -->
                    <Border Background="{StaticResource BadgeBgBrush}" CornerRadius="4" Padding="6,2" Margin="3,0">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Modifiers.Ctrl}" Value="True">
                                        <Setter Property="Background" Value="{StaticResource KeyActiveBrush}" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <TextBlock Text="{Binding Modifiers.CtrlStatusText}" FontSize="10" FontWeight="Bold" Foreground="White" />
                    </Border>

                    <!-- ALT pill -->
                    <Border Background="{StaticResource BadgeBgBrush}" CornerRadius="4" Padding="6,2" Margin="3,0">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Modifiers.Alt}" Value="True">
                                        <Setter Property="Background" Value="{StaticResource KeyActiveBrush}" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <TextBlock Text="{Binding Modifiers.AltStatusText}" FontSize="10" FontWeight="Bold" Foreground="White" />
                    </Border>

                    <!-- WIN pill -->
                    <Border Background="{StaticResource BadgeBgBrush}" CornerRadius="4" Padding="6,2" Margin="3,0">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Modifiers.WindowsKey}" Value="True">
                                        <Setter Property="Background" Value="{StaticResource KeyActiveBrush}" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <TextBlock Text="{Binding Modifiers.WindowsStatusText}" FontSize="10" FontWeight="Bold" Foreground="White" />
                    </Border>

                    <!-- Emergency Clear Button -->
                    <Button Style="{StaticResource HeaderActionButtonStyle}" Command="{Binding ResetModifiersCommand}" ToolTip="Release / Reset All Held Modifiers" Margin="6,0,0,0" Padding="6,2">
                        <TextBlock Text="🔄 Reset Mods" FontSize="10" />
                    </Button>
                </StackPanel>

                <!-- Custom Dedicated Quick Keys (P, Backspace, 4) -->
                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,10,0">
                    <TextBlock Text="⚡ Custom Keys:" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Center" Margin="0,0,4,0" />

                    <!-- Custom 'P' Button -->
                    <Button Style="{StaticResource ProminentCustomKeyButtonStyle}"
                            Command="{Binding KeyClickCommand}"
                            CommandParameter="{Binding QuickPKey}"
                            ToolTip="Custom P Key (Click to type P / p)"
                            Focusable="False">
                        <TextBlock Text="P" FontSize="13" FontWeight="Bold" />
                    </Button>

                    <!-- Custom '4' Button -->
                    <Button Style="{StaticResource ProminentCustomKeyButtonStyle}"
                            Command="{Binding KeyClickCommand}"
                            CommandParameter="{Binding Quick4Key}"
                            ToolTip="Custom 4 Key (Click to type 4 / $)"
                            Focusable="False">
                        <TextBlock Text="4 ($)" FontSize="13" FontWeight="Bold" />
                    </Button>

                    <!-- Custom 'Backspace' Button with repeat -->
                    <Button Style="{StaticResource ProminentCustomKeyButtonStyle}"
                            Command="{Binding KeyClickCommand}"
                            CommandParameter="{Binding QuickBackspaceKey}"
                            PreviewMouseDown="OnKeyButtonPreviewMouseDown"
                            PreviewMouseUp="OnKeyButtonPreviewMouseUp"
                            ToolTip="Custom Backspace Key (Press &amp; Hold to repeat)"
                            Focusable="False">
                        <TextBlock Text="⌫ Backspace" FontSize="12" FontWeight="Bold" Foreground="#FF9E80" />
                    </Button>

                    <!-- Quick Tools Separator -->
                    <Rectangle Width="1" Height="16" Fill="{StaticResource KeyBorderBrush}" Margin="6,0" />

                    <Button Style="{StaticResource HeaderActionButtonStyle}" Command="{Binding OpenTaskMgrCommand}" ToolTip="Open Task Manager" Padding="5,2">
                        <TextBlock Text="TaskMgr" FontSize="10" />
                    </Button>
                    <Button Style="{StaticResource HeaderActionButtonStyle}" Command="{Binding OpenOskCommand}" ToolTip="Open Windows OSK Fallback" Padding="5,2">
                        <TextBlock Text="WinOSK" FontSize="10" />
                    </Button>
                </StackPanel>
            </Grid>

            <!-- 3. MAIN KEYBOARD BODY -->
            <Grid Grid.Row="2" Margin="6,4,6,6">
                <!-- 3A. DEDICATED 3-KEY KEYBOARD VIEW (P, 4, Backspace + tiny settings gear) -->
                <Grid Visibility="{Binding Settings.MiniTrioOnly, Converter={StaticResource BoolToVis}}">
                    <Grid.RowDefinitions>
                        <!-- Thin draggable handle bar (Height 18) with a tiny gear -->
                        <RowDefinition Height="20" />
                        <!-- Three Keys fill the remaining space -->
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <!-- Thin Drag Handle, Special Symbols Menu Button, and Gear Settings -->
                    <Grid Grid.Row="0" MouseLeftButtonDown="OnTitleBarMouseDown" Background="Transparent" Cursor="SizeAll">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <!-- Mini Menu Button on opposite side for Special Keys ~!@#$%^&*() -->
                        <Button Grid.Column="0"
                                Style="{StaticResource HeaderActionButtonStyle}"
                                Command="{Binding ToggleSpecialSymbolsCommand}"
                                ToolTip="Special Symbols (~ ! @ # $ % ^ &amp; * ( ))"
                                Margin="2,0,2,0"
                                Padding="4,1"
                                Focusable="False">
                            <TextBlock Text="~#" FontSize="10" FontWeight="Bold" Foreground="#64B5F6" />
                        </Button>

                        <!-- Subtle Drag Indicator -->
                        <TextBlock Grid.Column="1" Text="::: Rescue Bar :::"
                                   FontSize="10"
                                   Foreground="#55586D"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center" />

                        <!-- Tiny Settings Gear (Opens Customization Window) -->
                        <Button Grid.Column="2"
                                Style="{StaticResource HeaderActionButtonStyle}"
                                Click="OnOpenSettingsWindowClick"
                                ToolTip="Settings &amp; Key Customization"
                                Margin="2,0,2,0"
                                Padding="4,1"
                                Focusable="False">
                            <TextBlock Text="⚙️" FontSize="11" />
                        </Button>
                    </Grid>

                    <!-- Dynamic Rescue Keys Filling the Window -->
                    <Grid Grid.Row="1" x:Name="QuickBarGrid" Margin="1,2,1,1" />
                </Grid>

                <!-- 3B. FULL KEYBOARD VIEW (shown when MiniTrioOnly is false) -->
                <Grid Visibility="{Binding Settings.MiniTrioOnly, Converter={StaticResource InvertBoolToVis}}">
                    <Grid.ColumnDefinitions>
                        <!-- Main Keyboard (Function + QWERTY) -->
                        <ColumnDefinition Width="*" />
                        <!-- Navigation Cluster -->
                        <ColumnDefinition Width="Auto" />
                        <!-- Numpad -->
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <!-- MAIN SECTION -->
                    <Grid Grid.Column="0">
                        <Grid.RowDefinitions>
                            <!-- Function Row (Collapsible in compact mode) -->
                            <RowDefinition Height="Auto" />
                            <!-- QWERTY Rows -->
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <!-- Function Row -->
                        <ItemsControl Grid.Row="0"
                                      ItemsSource="{Binding FunctionRows[0]}"
                                      ItemTemplate="{StaticResource KeyButtonTemplate}"
                                      Visibility="{Binding Settings.CompactMode, Converter={StaticResource InvertBoolToVis}}"
                                      Margin="0,0,0,2">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <UniformGrid Rows="1" />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                        </ItemsControl>

                        <!-- 5 QWERTY Main Rows -->
                        <Grid Grid.Row="1" x:Name="MainKeyboardGrid">
                            <!-- Populated and dynamically laid out row by row in code-behind / XAML -->
                        </Grid>
                    </Grid>

                    <!-- NAVIGATION CLUSTER -->
                    <Border Grid.Column="1"
                            BorderBrush="{StaticResource KeyBorderBrush}"
                            BorderThickness="1,0,0,0"
                            Margin="4,0"
                            Padding="4,0"
                            Visibility="{Binding Settings.ShowNavCluster, Converter={StaticResource BoolToVis}}">
                        <Grid x:Name="NavClusterGrid" VerticalAlignment="Center">
                            <!-- Populated in code-behind / XAML -->
                        </Grid>
                    </Border>

                    <!-- NUMPAD -->
                    <Border Grid.Column="2"
                            BorderBrush="{StaticResource KeyBorderBrush}"
                            BorderThickness="1,0,0,0"
                            Margin="4,0"
                            Padding="4,0"
                            Visibility="{Binding Settings.ShowNumpad, Converter={StaticResource BoolToVis}}">
                        <Grid x:Name="NumpadGrid" VerticalAlignment="Center">
                            <!-- Populated in code-behind / XAML -->
                        </Grid>
                    </Border>
                </Grid>
            </Grid>

            <!-- OVERLAY 1: FN QUICK ACTIONS MENU -->
            <Border Grid.Row="1" Grid.RowSpan="2"
                    Background="#EE1E1E24"
                    Visibility="{Binding IsFnMenuOpen, Converter={StaticResource BoolToVis}}"
                    Panel.ZIndex="10">
                <Border Background="{StaticResource SurfaceBgBrush}"
                        BorderBrush="{StaticResource KeyBorderBrush}"
                        BorderThickness="1"
                        CornerRadius="8"
                        Width="450"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Padding="16">
                    <StackPanel>
                        <DockPanel Margin="0,0,0,12">
                            <TextBlock Text="⚡ Fn Quick System Actions" FontWeight="Bold" FontSize="14" Foreground="{StaticResource TextPrimaryBrush}" />
                            <Button DockPanel.Dock="Right" Style="{StaticResource HeaderActionButtonStyle}" Command="{Binding ToggleFnMenuCommand}" HorizontalAlignment="Right" Content="✕ Close" />
                        </DockPanel>
                        <TextBlock Text="Hardware Fn keys are laptop-specific. Use these guaranteed Windows system commands:" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,12" TextWrapping="Wrap" />

                        <UniformGrid Columns="3" Margin="0,4">
                            <Button Style="{StaticResource HeaderActionButtonStyle}" Command="{Binding FnActionCommand}" CommandParameter="Mute" Margin="4" Padding="10,8">
                                <TextBlock Text="🔇 Mute" />
                            </Button>
                            <Button Style="{StaticResource HeaderActionButtonStyle}" Command="{Binding FnActionCommand}" CommandParameter="VolDown" Margin="4" Padding="10,8">
                                <TextBlock Text="🔉 Vol Down" />
                            </Button>
                            <Button Style="{StaticResource HeaderActionButtonStyle}" Command="{Binding FnActionCommand}" CommandParameter="VolUp" Margin="4" Padding="10,8">
                                <TextBlock Text="🔊 Vol Up" />
                            </Button>
                            <Button Style="{StaticResource HeaderActionButtonStyle}" Command="{Binding FnActionCommand}" CommandParameter="PrevTrack" Margin="4" Padding="10,8">
                                <TextBlock Text="⏮ Previous" />
                            </Button>
                            <Button Style="{StaticResource HeaderActionButtonStyle}" Command="{Binding FnActionCommand}" CommandParameter="PlayPause" Margin="4" Padding="10,8">
                                <TextBlock Text="⏯ Play/Pause" />
                            </Button>
                            <Button Style="{StaticResource HeaderActionButtonStyle}" Command="{Binding FnActionCommand}" CommandParameter="NextTrack" Margin="4" Padding="10,8">
                                <TextBlock Text="⏭ Next" />
                            </Button>
                            <Button Style="{StaticResource HeaderActionButtonStyle}" Command="{Binding FnActionCommand}" CommandParameter="Project" Margin="4" Padding="10,8">
                                <TextBlock Text="🖥️ Win+P Project" />
                            </Button>
                            <Button Style="{StaticResource HeaderActionButtonStyle}" Command="{Binding FnActionCommand}" CommandParameter="LockScreen" Margin="4" Padding="10,8">
                                <TextBlock Text="🔒 Win+L Lock" />
                            </Button>
                            <Button Style="{StaticResource HeaderActionButtonStyle}" Command="{Binding FnActionCommand}" CommandParameter="SoundSettings" Margin="4" Padding="10,8">
                                <TextBlock Text="🎛 Sound Set" />
                            </Button>
                        </UniformGrid>
                    </StackPanel>
                </Border>
            </Border>



            <!-- OVERLAY 3: FIRST-RUN GUIDE -->
            <Border Grid.Row="1" Grid.RowSpan="2"
                    Background="#EE1E1E24"
                    Visibility="{Binding IsFirstRunGuideOpen, Converter={StaticResource BoolToVis}}"
                    Panel.ZIndex="12">
                <Border Background="{StaticResource SurfaceBgBrush}"
                        BorderBrush="{StaticResource KeyBorderBrush}"
                        BorderThickness="1"
                        CornerRadius="8"
                        Width="560"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Padding="18">
                    <StackPanel>
                        <DockPanel Margin="0,0,0,12">
                            <TextBlock Text="📖 KeyBuddy Quick Start Guide" FontWeight="Bold" FontSize="15" Foreground="{StaticResource TextPrimaryBrush}" />
                            <Button DockPanel.Dock="Right" Style="{StaticResource HeaderActionButtonStyle}" Command="{Binding ToggleFirstRunGuideCommand}" HorizontalAlignment="Right" Content="✕ Close" />
                        </DockPanel>

                        <TextBlock Text="KeyBuddy provides a native Windows virtual keyboard that sends input to any application without physical keyboard dependency." FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" TextWrapping="Wrap" Margin="0,0,0,10" />

                        <StackPanel Margin="0,4">
                            <TextBlock Text="1. Targeting Any Application" FontWeight="SemiBold" Foreground="{StaticResource AccentBrush}" Margin="0,4,0,2" />
                            <TextBlock Text="Click into your target app (e.g. Notepad, Chrome, VS Code). The Target bar at the top displays the active target window automatically." Foreground="White" FontSize="11" TextWrapping="Wrap" />

                            <TextBlock Text="2. Clicking Keys &amp; Repeat" FontWeight="SemiBold" Foreground="{StaticResource AccentBrush}" Margin="0,6,0,2" />
                            <TextBlock Text="Click any key with the mouse. Press and hold Backspace or Arrow keys to smoothly repeat." Foreground="White" FontSize="11" TextWrapping="Wrap" />

                            <TextBlock Text="3. Modifiers &amp; Shortcuts" FontWeight="SemiBold" Foreground="{StaticResource AccentBrush}" Margin="0,6,0,2" />
                            <TextBlock Text="• Single click Shift for one capitalized letter. Double-click Shift to lock it.&#x0a;• Click Ctrl, then C to copy. Click Alt, then Tab to switch windows.&#x0a;• Modifiers automatically release after sending, or click 'Reset Mods' anytime." Foreground="White" FontSize="11" TextWrapping="Wrap" />

                            <TextBlock Text="4. Emergency Quick Launch" FontWeight="SemiBold" Foreground="{StaticResource AccentBrush}" Margin="0,6,0,2" />
                            <TextBlock Text="Use the top buttons for 1-click access to Task Manager, File Explorer, Windows OSK, or Windows Settings." Foreground="White" FontSize="11" TextWrapping="Wrap" />
                        </StackPanel>
                    </StackPanel>
                </Border>
            </Border>

        </Grid>
    </Border>
</Window>
